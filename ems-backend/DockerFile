# Stage 1: Build the app with Maven
FROM maven:3.9.2-eclipse-temurin-18 AS build

WORKDIR /app

# Copy pom.xml and download dependencies (cached if unchanged)
COPY pom.xml .
RUN mvn dependency:go-offline

# Copy the rest of the source code
COPY src ./src

# Build the application, skipping tests
RUN mvn clean package -DskipTests

# Stage 2: Run the app with a lightweight Java runtime
FROM eclipse-temurin:18-jre-alpine

WORKDIR /app

# Copy the built jar from the build stage
COPY --from=build /app/target/ems-backend-0.0.1-SNAPSHOT.jar app.jar

# Expose port 8080 (or your configured port)
EXPOSE 8080

# Run the jar
ENTRYPOINT ["java", "-jar", "app.jar"]
